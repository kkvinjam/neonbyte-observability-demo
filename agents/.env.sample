# Optional local overrides for the agents (loaded from agents/.env).
AWS_REGION=us-east-1
# AWS_PROFILE=my-bedrock-profile
DISABLE_SSM=true
# local | http | gateway
AGENT_TRANSPORT=local
CATALOG_URL=http://127.0.0.1:8081
CART_URL=http://127.0.0.1:8082
ORDERS_URL=http://127.0.0.1:8083
# Swap models without code changes, e.g. for EU regions use the eu. inference profiles:
# BEDROCK_CLAUDE_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# ORDERDESK_MODEL_ID=us.amazon.nova-2-lite-v1:0
